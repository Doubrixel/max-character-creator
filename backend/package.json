{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import=tsx src/server.ts",
    "start": "node --import=tsx src/server.ts",
    "test": "node --import=tsx --test src/db/seed.test.ts src/cultures/cultures.test.ts src/cultures/kultur-editor.test.ts src/cultures/kultur-wahl.test.ts src/routes/library-cultures.test.ts src/routes/characters-ges.test.ts src/config.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx src/db/seed-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "wipe:characters": "tsx src/scripts/wipe-characters.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@libsql/client": "^0.14.0",
    "@mcc/shared": "*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.11"
  }
}
